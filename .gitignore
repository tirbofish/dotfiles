# ~/.config is an application-data dump. Ignore every top-level entry,
# then allow only portable configuration. New apps are ignored automatically;
# add a `!/name/` (or `!/file`) line when you want something new in this repo.

/*
!/.gitignore
!/README.md
!/install.sh
!/kcminputrc
!/kdeglobals
!/mimeapps.list
!/starship.toml

!/ags/
!/clangd/
!/color-schemes/
!/dunst/
!/fastfetch/
!/gh/
!/gtk-3.0/
!/gtk-4.0/
!/hypr/
!/hyprpolkitagent/
!/kitty/
!/Kvantum/
!/mako/
!/nvim/
!/nyaa/
!/pipewire/
!/qt6ct/
!/quickshell/
!/rofi/
!/snappy-switcher/
!/spotatui/
!/swappy/
!/systemd/
!/Thunar/
!/waybar/
!/wireplumber/
!/xfce4/
!/zathura/
!/zsh/

# Generated, machine-local, and secret files inside otherwise-tracked configs
**/.cache/
**/Cache/
**/*.bak
**/*.log
**/*.tmp
**/*~
**/.env
**/.env.*
**/.netrc
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.o
**/*.pyc
**/__pycache__/
**/bookmarks
**/known_hosts*
**/profile.jpg
**/recently-used*
/quickshell/weather_api.conf
/gh/hosts.yml
/spotatui/client.yml
/spotatui/.spotify_token_cache*.json
/spotatui/streaming_cache/
/spotatui/history/
/spotatui/spotatui-recap.html
/systemd/user/*.wants/

# Scratch copies, compiled helpers, and local tests
/hypr/backup-*/
/hypr/scripts/hyprlock-biopass-auth
/hypr/scripts/test-*.lua
/quickshell/desktop/test-*.cjs
/quickshell/desktop/tests/

# Runtime layout and this-machine display serials
/quickshell/desktop/widgets.json
/quickshell/lib/monitors.json
/hypr/monitors.conf
/hypr/monitors.lua
/quickshell/lib/test-*.cjs

# Last-screenshot filename and other per-machine app state
/swappy/config
/mimeapps.list

# User units with absolute home paths, venvs, and tokens
/systemd/user/hermes-gateway.service
/systemd/user/opencodex-proxy.service
/systemd/user/a1-hunter.service
/systemd/user/cpu-starvation-guard.service

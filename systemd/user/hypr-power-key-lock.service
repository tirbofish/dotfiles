[Unit]
Description=Inhibit logind power-off so the power button can lock
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=handle-power-key --who=Hyprland --why=power-button-lock --mode=block /usr/bin/sleep infinity
Restart=on-failure

[Install]
WantedBy=default.target

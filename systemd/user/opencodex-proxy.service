[Unit]
Description=OpenCodex Proxy Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="/bin/sh" -lc "if [ -f '/home/tirbofish/.opencodex/service-api-token' ]; then OPENCODEX_API_AUTH_TOKEN=\"$(cat '/home/tirbofish/.opencodex/service-api-token')\"; export OPENCODEX_API_AUTH_TOKEN; fi; exec '/home/tirbofish/node_modules/bun/bin/bun.exe' '/home/tirbofish/node_modules/@bitkyc08/opencodex/src/cli/index.ts' start --port 10100"
Restart=on-failure
RestartSec=5
Environment="OCX_SERVICE=1"
Environment="OCX_BUN_RUNTIME_SOURCE=bundled"
Environment="OCX_BUN_RUNTIME_PATH=/home/tirbofish/node_modules/bun/bin/bun.exe"
Environment="PATH=/home/tirbofish/.nvm/versions/node/v26.7.0/bin:/home/tirbofish/go/bin:/home/tirbofish/.local/bin:/home/tirbofish/.bun/bin:/home/tirbofish/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/home/tirbofish/.zvm/bin:/home/tirbofish/.zvm/self/:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl:/home/tirbofish/.zvm/bin:/home/tirbofish/.zvm/self/"
StandardOutput=append:/home/tirbofish/.opencodex/service.log
StandardError=append:/home/tirbofish/.opencodex/service.log

[Install]
WantedBy=default.target
